         snd_trace_busreq("REQ", b->z80_busreq); return; }                /* [SND-TRACE] */
     if (a == 0xA11200u) { int o = b->z80_reset_off; b->z80_reset_off = (v & 0x0100) ? 1 : 0;
--- a/runner/main.c
